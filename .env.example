# Pinned images. Check upstream release notes before upgrading.
OLLAMA_IMAGE=ollama/ollama:0.32.15
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:v0.11.0

# Local-only by default. Use 0.0.0.0 only behind authentication + TLS.
OLLAMA_BIND=127.0.0.1
OLLAMA_PORT=11434
WEBUI_BIND=127.0.0.1
WEBUI_PORT=3000
WEBUI_NAME=БРОДЯГА

# The first Open WebUI account becomes administrator.
# Set to false after creating it if you do not need more registrations.
ENABLE_SIGNUP=true
WEBUI_AUTH=true

# Default model pair (Q4 quantization in Ollama).
QWEN_MODEL=qwen3:8b
VLM_MODEL=qwen3-vl:8b

# Runtime tuning. Larger context consumes substantially more RAM/VRAM.
OLLAMA_CONTEXT_LENGTH=32768
OLLAMA_KEEP_ALIVE=5m
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1

# Used only by compose.native.yaml (Ollama installed on the host).
OLLAMA_NATIVE_URL=http://host.docker.internal:11434
