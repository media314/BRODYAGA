# БРОДЯГА profile: GeForce RTX 3060 12 GB
# Used by: make rtx3060

OLLAMA_IMAGE=ollama/ollama:0.32.15
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:v0.11.0

OLLAMA_BIND=127.0.0.1
OLLAMA_PORT=11434
WEBUI_BIND=127.0.0.1
WEBUI_PORT=3000
WEBUI_NAME="БРОДЯГА · RTX 3060 12 GB"
ENABLE_SIGNUP=true
WEBUI_AUTH=true

# Both fit individually. Loading both at once does not leave safe VRAM headroom.
QWEN_MODEL=qwen3:8b
VLM_MODEL=qwen3-vl:8b

# Conservative settings for keeping inference entirely on the 12 GB GPU.
OLLAMA_CONTEXT_LENGTH=16384
OLLAMA_KEEP_ALIVE=0
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0

# Hard container ceilings. These are limits, not reserved memory.
OLLAMA_MEMORY_LIMIT=12g
WEBUI_MEMORY_LIMIT=4g
